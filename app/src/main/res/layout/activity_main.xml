<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:id="@+id/homePage"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <TextView
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="15dp"
            android:fontFamily="@font/rubik_mono_one"
            android:text="IPYNB VIEWER"
            android:textSize="20sp" />

        <com.airbnb.lottie.LottieAnimationView
            android:layout_width="150dp"
            android:layout_height="150dp"
            app:lottie_fileName="titleanimation.lottie"
            android:layout_gravity="center"
            android:layout_marginBottom="20dp"
            app:lottie_loop="true"
            app:lottie_autoPlay="true"/>

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp">

            <Button
                android:id="@+id/choosefile"
                style="@style/Widget.Material3.Button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:backgroundTint="@color/widgets"
                android:fontFamily="@font/roboto_condensed_regular"
                android:text="SELECT FILE"
                android:textColor="@color/widgetsText"
                android:textSize="12sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/convertOnline"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:strokeColor="@color/widgets"
                android:textSize="12sp"
                android:drawableRight="@drawable/beta"
                app:iconTint="@color/widgets"
                android:fontFamily="@font/roboto_condensed_regular"
                android:text="ONLINE  "
                android:layout_alignParentRight="true"
                android:textColor="@color/black"
                android:textStyle="bold"
                app:rippleColor="#66A65E2E"/>
        </RelativeLayout>

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp">
            <RadioGroup
                android:id="@+id/radioRender"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_alignParentLeft="true">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Render:"
                    android:textStyle="bold"
                    android:textSize="12sp"
                    android:fontFamily="@font/roboto_condensed_regular"
                    android:textColor="@color/black"/>

                <RadioButton
                    android:id="@+id/radioReal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Core"
                    android:layout_marginRight="5dp"
                    android:textStyle="bold"
                    android:textSize="12sp"
                    app:buttonTint="@color/widgets"
                    android:fontFamily="@font/roboto_condensed_regular"
                    android:textColor="@color/black"/>

                <RadioButton
                    android:id="@+id/radioBasic"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Lite"
                    android:textStyle="bold"
                    android:textSize="12sp"
                    app:buttonTint="@color/widgets"
                    android:fontFamily="@font/roboto_condensed_regular"
                    android:textColor="@color/black"/>

            </RadioGroup>

            <Button
                android:id="@+id/getPro"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:strokeColor="@color/widgets"
                android:textSize="12sp"
                android:drawableRight="@drawable/pro"
                app:iconTint="@color/widgets"
                android:fontFamily="@font/roboto_condensed_regular"
                android:text="GET PRO"
                android:layout_alignParentRight="true"
                android:textColor="@color/black"
                android:textStyle="bold"
                app:rippleColor="#66A65E2E"/>

        </RelativeLayout>

        <com.google.android.gms.ads.AdView
            android:id="@+id/adView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="16dp"
            app:adSize="MEDIUM_RECTANGLE"
            app:adUnitId="ca-app-pub-1715775523919691/3323866400"/>

    </LinearLayout>

</ScrollView>

