<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:id="@+id/homePage"
    android:padding="20dp"
    android:background="@color/primaryColor">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:layout_marginBottom="15dp">

            <TextView
                android:id="@+id/title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerHorizontal="true"
                android:layout_centerVertical="true"
                android:fontFamily="@font/rubik_mono_one"
                android:text="IPYNB VIEWER"
                android:textSize="20sp"
                android:textColor="@color/widgetsText"/>

            <ImageButton
                android:id="@+id/getPro"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/pro"
                android:contentDescription="Get Pro"
                android:padding="8dp"/>
        </RelativeLayout>

        <com.airbnb.lottie.LottieAnimationView
            android:layout_width="150dp"
            android:layout_height="150dp"
            app:lottie_fileName="titleanimation.lottie"
            android:layout_gravity="center"
            android:layout_marginBottom="20dp"
            app:lottie_loop="true"
            app:lottie_autoPlay="true"/>

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp">

            <Button
                android:id="@+id/choosefile"
                style="@style/Widget.Material3.Button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:backgroundTint="@color/accentCustom"
                android:fontFamily="@font/roboto_condensed_regular"
                android:text="SELECT FILE"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/convertOnline"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:strokeColor="@color/accentCustom"
                android:textSize="12sp"
                android:drawableRight="@drawable/beta"
                app:iconTint="@color/accentCustom"
                android:fontFamily="@font/roboto_condensed_regular"
                android:text="ONLINE  "
                android:layout_alignParentRight="true"
                android:textColor="@color/widgetsText"
                android:textStyle="bold"
                app:rippleColor="#66A65E2E"/>
        </RelativeLayout>

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp">
            <RadioGroup
                android:id="@+id/radioRender"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_alignParentLeft="true">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Render:"
                    android:textStyle="bold"
                    android:textSize="12sp"
                    android:fontFamily="@font/roboto_condensed_regular"
                    android:textColor="@color/widgetsText"/>

                <RadioButton
                    android:id="@+id/radioReal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Core"
                    android:layout_marginRight="5dp"
                    android:textStyle="bold"
                    android:textSize="12sp"
                    app:buttonTint="@color/accentCustom"
                    android:fontFamily="@font/roboto_condensed_regular"
                    android:textColor="@color/widgetsText"/>

                <RadioButton
                    android:id="@+id/radioBasic"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Lite"
                    android:textStyle="bold"
                    android:textSize="12sp"
                    app:buttonTint="@color/accentCustom"
                    android:fontFamily="@font/roboto_condensed_regular"
                    android:textColor="@color/widgetsText"/>

            </RadioGroup>

            <Button
                android:id="@+id/btnUniversalReaderSmall"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:strokeColor="@color/accentCustom"
                android:textSize="12sp"
                android:fontFamily="@font/roboto_condensed_regular"
                android:text="TRY UNIVERSAL APP"
                android:layout_alignParentRight="true"
                android:textColor="@color/widgetsText"
                android:textStyle="bold"
                app:rippleColor="#66A65E2E"
                android:visibility="gone"/>

        </RelativeLayout>

        <!-- Universal Reader Promotion Banner -->
        <LinearLayout
            android:id="@+id/universalReaderBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/rounded"
            android:orientation="vertical"
            android:padding="16dp"
            android:visibility="visible">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentLeft="true"
                    android:layout_centerVertical="true"
                    android:layout_toLeftOf="@+id/closeBanner"
                    android:text="Try Universal App 🚀"
                    android:fontFamily="@font/roboto_condensed_regular"
                    android:textColor="@color/widgetsText"
                    android:textStyle="bold"
                    android:textSize="16sp"/>

                <ImageButton
                    android:id="@+id/closeBanner"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_alignParentRight="true"
                    android:layout_centerVertical="true"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_close"
                    app:tint="@color/widgetsText"
                    android:contentDescription="Close Banner"/>

            </RelativeLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/universal_app_promo_desc"
                android:textColor="@color/widgetsText"
                android:fontFamily="@font/roboto_condensed_regular"
                android:textSize="13sp"
                android:alpha="0.8"/>

            <Button
                android:id="@+id/btnInstallUniversalReader"
                style="@style/Widget.Material3.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:backgroundTint="@color/accentCustom"
                android:fontFamily="@font/roboto_condensed_regular"
                android:text="INSTALL FREE"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:textStyle="bold" />

        </LinearLayout>



        <com.google.android.gms.ads.AdView
            android:id="@+id/adView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="16dp"
            app:adSize="MEDIUM_RECTANGLE"
            app:adUnitId="ca-app-pub-1715775523919691/3323866400"/>

<!--  DUMMY      ca-app-pub-3940256099942544/9214589741 -->


    </LinearLayout>

</ScrollView>

