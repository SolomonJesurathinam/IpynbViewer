<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".original_NB">

    <TextView
        android:id="@+id/ncbonvert"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_above="@id/experimental"
        android:layout_centerInParent="true"
        android:gravity="center"
        android:text="NbConvert"
        android:textColor="@color/colorText"
        android:textSize="20sp" />

    <TextView
        android:id="@+id/experimental"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_above="@+id/text"
        android:layout_centerInParent="true"
        android:gravity="center"
        android:text="EXPERIMENTAL"
        android:textColor="#BDA509"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:layout_marginLeft="10sp"
        android:layout_marginTop="10sp"
        android:layout_marginRight="10sp"
        android:layout_marginBottom="20sp"
        android:textSize="14sp"
        android:text="This is an experimental feature which uses original nbconvert tool to convert a Jupyter notebook document to pdf in cloud. Currently we can upload ipynb files and download them as pdf, and the uploaded files are auto deleted from cloud."
        android:textColor="@color/colorText" />

    <Button
        android:id="@+id/experimentalButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/text"
        android:layout_centerInParent="true"
        android:background="@drawable/mybutton"
        android:text="Start"
        android:textColor="@color/colorText"
        app:backgroundTint="@null" />

    <TextView
        android:id="@+id/addText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Warning!! Full screen ads are shown on next page to cover up the server charges. Thank you!"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="20sp"
        android:layout_marginLeft="10sp"
        android:layout_marginRight="10sp"
        android:textColor="#E17979"
        android:visibility="invisible"/>




</RelativeLayout>